{
  "name": "live.ts",
  "type": "module",
  "version": "0.1.0",
  "exports": {
    "./client": {
      "default": "./dist/client/live.ts.modern.js",
      "types": "./dist/client.d.ts"
    },
    "./server": {
      "default": "./dist/server/live.ts.modern.js",
      "types": "./dist/server.d.ts"
    }
  },
  "main": "./dist/server/index.js",
  "module": "./dist/client/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "demo-server-dev": "ts-node --transpileOnly --project demo/server/tsconfig.json demo/server/index.ts",
    "test": "vitest",
    "build": "yarn build-server; yarn build-client",
    "build-server": "microbundle --no-compress --entry ./server.ts -o dist/server --target node --format modern --external socket.io,express,fs,path,mime-types,cors,redis",
    "build-client": "microbundle --no-compress --entry ./client.ts -o dist/client --target web --format modern --external uuid,socket.io-client,react"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mime-types": "^2.1.4",
    "@types/react": "^18.2.45",
    "@types/uuid": "^9.0.7",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "microbundle": "^0.15.1",
    "mime-types": "^2.1.35",
    "react": "^18.2.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "uuid": "^9.0.1",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "redis": "^4.7.0"
  }
}
